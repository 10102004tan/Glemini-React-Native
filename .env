# API Configuration
API_URL=http://192.168.2.4:3000
API_VERSION_V1=/api/v1

# Auth Configuration
AUTH_TOKEN_EXPIRES=30d
REFRESH_TOKEN_EXPIRES=365d

# Socket Configuration
SOCKET_URL=ws://192.168.2.4:3000

# Storage Configuration
STORAGE_URL=http://192.168.2.4:3000/uploads

# App Configuration
APP_NAME=Glemini
APP_DESCRIPTION="Learning Management System"
DEFAULT_LANGUAGE=vi
MAX_FILE_SIZE=5242880 # 5MB

# Features Configuration
ENABLE_NOTIFICATIONS=true
ENABLE_SOCKET=true
ENABLE_OFFLINE_MODE=true

# Third Party Services
GEMINI_API_KEY=your_gemini_api_key
